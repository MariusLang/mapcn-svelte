{
	"name": "mapcn-svelte",
	"private": true,
	"version": "0.3",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"scripts": {
		"dev": "vite dev --port 62726",
		"build": "pnpm build:registry && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"build:registry": "pnpm shadcn-svelte registry build",
		"blocks:thumbnails": "node scripts/capture-block-thumbnails.ts"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"d3-shape": "^3.2.0",
		"maplibre-gl": "^6.13.0",
		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.54.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-shape": "^3.2.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"layerchart": "2.6.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"playwright": "~1.64.0"
	}
}

{
	"name": "mapcn-svelte",
	"private": true,
	"version": "0.3",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"dev": "vite dev --port 62726",
		"build": "pnpm build:registry && vite build",
		"preview": "vite preview",
		"prepare": "node --loader ./scripts/typescript6-loader.mjs ./node_modules/@sveltejs/kit/svelte-kit.js sync || echo ''",
		"check": "node --loader ./scripts/typescript6-loader.mjs ./node_modules/@sveltejs/kit/svelte-kit.js sync && node scripts/svelte-check-ts6.cjs --tsconfig ./tsconfig.json",
		"check:watch": "node --loader ./scripts/typescript6-loader.mjs ./node_modules/@sveltejs/kit/svelte-kit.js sync && node scripts/svelte-check-ts6.cjs --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format": "prettier --write .",
		"lint": "prettier --check . && node scripts/eslint-ts6.cjs .",
		"build:registry": "pnpm shadcn-svelte registry build"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"maplibre-gl": "^5.24.0",
		"shiki": "^4.3.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.22.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/d3-shape": "^3.1.8",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.0.1",
		"@vitest/coverage-v8": "^4.1.9",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"layerchart": "2.0.0-next.57",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-svelte-check": "npm:typescript@^6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^8.1.3",
		"vitest": "^4.1.9"
	}
}
